# Buyunda Primary School - Environment Configuration

# SMTP Server Configuration
# For Gmail: Use smtp.gmail.com, Port 587, Secure 'tls', and generate a 16-character App Password (Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-actual-email@gmail.com
SMTP_PASS=your-16-digit-app-password
SMTP_FROM_NAME="Buyunda Primary School"
SMTP_FROM_EMAIL=your-actual-email@gmail.com

# Administrator Notification Recipient Email
ADMIN_NOTIFICATION_EMAIL=admin@buyundaprimaryschool.org